# Secrets & tokens — NEVER commit these
client_secret.json
token.json
*.pickle

# User-specific config written by `setup` (contains your playlist names)
config.json

# User-specific keyword rules (contain your playlist names/keywords).
# Only rules.example.json is shipped as the template.
rules.json
*.backup.json

# Generated artifacts (sort previews, plan dumps — contain your video titles)
output/

# Generated interactive pages written next to the script (contain your video
# titles). `sort --html` writes plan.html; `map`/`setup [2]` writes map.html
# (plus the advanced category-map.html / keyword-map.html variants).
map.html
plan.html
category-map.html
keyword-map.html

# Generated console-paste page (rebuild with `node tools/build-console-page.cjs`)
watchlater-console.html

# Undo journals (record your moved video titles/ids — local safety net only)
history/

# Python
venv/
__pycache__/
*.pyc
.env
